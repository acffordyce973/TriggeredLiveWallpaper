{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Release APK",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/.vscode/BuildRelease.ps1"
			],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"focus": true
			},
			"problemMatcher": []
		},
		{
			"label": "Run App on ADB Device",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/.vscode/RunAdbDevice.ps1",
				"-stringDeviceId",
				"auto"
			],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"focus": false
			},
			"problemMatcher": []
		},
		{
			"label": "Start Emulated Device",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/.vscode/LaunchEmulator.ps1",
				"-stringAvdName",
				"auto"
			],
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"focus": false
			},
			"problemMatcher": []
		},
		{
			"label": "Run App on Emulated Device",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/.vscode/RunApp.ps1",
				"-stringAvdName",
				"auto"
			],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"focus": false
			},
			"problemMatcher": []
		},
		{
			"label": "Assemble Debug APK",
			"type": "shell",
			"command": ".\\gradlew.bat",
			"args": [
				"assembleDebug"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "Install Debug APK",
			"type": "shell",
			"command": ".\\gradlew.bat",
			"args": [
				"installDebug"
			],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "Run Unit Tests",
			"type": "shell",
			"command": ".\\gradlew.bat",
			"args": [
				"testDebugUnitTest"
			],
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		}
	]
}